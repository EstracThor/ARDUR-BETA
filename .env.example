DJANGO_SETTINGS_MODULE=ardur.config.settings.development
DJANGO_SECRET_KEY=development-only-change-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
POSTGRES_DB=ardur
POSTGRES_USER=ardur
POSTGRES_PASSWORD=local-development-change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://redis:6379/0
# Obligatoria para seed_beta; use una contraseña propia de al menos 12 caracteres.
DEMO_PASSWORD=
# Proveedor XYZ opcional; mantenga la atribución y política del proveedor.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
